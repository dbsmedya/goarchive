# Test 07: copy-only -- copy to the destination WITHOUT deleting from source
#
# The suite's only `copy-only` coverage. copy-only is the one command that never
# deletes, so the assertion that carries this test is the NEGATIVE one: the
# source count must be IDENTICAL before and after. Without it this is an archive
# test under a different name.
#
# Same graph and same slice as test 04 (rental -> payment, rental_id <= 200), so
# a failure here that test 04 does not share isolates to the command. batch_size
# 10 gives 20 full batches, so the batch loop runs many times; each is followed by
# a sleep, the last one by the fetch that finds nothing.
#
# NO batch_delete_size and NO delete_sleep_seconds: copy-only deletes nothing,
# so both are inert, and the pacing floor has no delete term.
#
# safety.disable_foreign_key_checks IS required: the destination's payment table
# references customer and staff, which are not copied. That is also why the runner
# asserts referential integrity explicitly (orphan_checks).
#
# resume is left at its default (false): the destination starts empty.
# verification: count, declared (3.0's default is sha256).
#
# This template is the tracked source of truth. run-tests.sh renders it to
# test07_rental_payment_copyonly.yaml on every run, substituting the MYSQL_ROOT_PASSWORD placeholder from
# tests/.env. Edit this file, never the generated .yaml -- that one is gitignored
# (it holds a real password) and is overwritten.

source:
  host: 127.0.0.1
  port: 3305
  user: root
  password: ${MYSQL_ROOT_PASSWORD}
  database: sakila

destination:
  host: 127.0.0.1
  port: 3307
  user: root
  password: ${MYSQL_ROOT_PASSWORD}
  database: sakila_archive

safety:
  disable_foreign_key_checks: true

# run_archive_job extracts the job name with `grep -A 1 "^jobs:" | tail -1`, so
# the job key must be the very next line -- no comment, and no trailing comment
# on the key itself, or the extracted name comes out mangled.
jobs:
  copy-rental-payments:
    job_type: copy-only
    root_table: rental
    primary_key: rental_id
    # The same 200 rentals as test 04, pulling in the same 200 payments.
    where: "rental_id <= 200"
    verification: count
    processing:
      # 200 rentals / 10 = 20 full batches.
      batch_size: 10
      # 20 batches x 0.5s = 10.0s.
      sleep_seconds: 0.5
    relations:
      # a rental has many payments (payment.rental_id -> rental)
      - table: payment
        primary_key: payment_id
        foreign_key: rental_id
