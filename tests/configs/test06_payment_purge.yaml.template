# Test 06: purge -- delete from source WITHOUT copying anything
#
# The suite's ordinary `purge` control. purge is the one destructive command that
# deletes without copying, so a mistake here is unrecoverable -- which is why
# this test purges HALF the payment table rather than a token slice: the gap
# between a correct run (8022 rows) and a runaway one (16044) is then large and
# unmistakable, and the runner asserts the exact number, not a direction.
#
# payment_id <= 8024 selects exactly 8022 of payment's 16044 rows. The boundary
# is 8024 and not 8022 because payment_id is NOT contiguous -- two ids below it
# are missing. It was queried against the fixture, not computed.
#
# Sizing (batch_size 500 / batch_delete_size 100) gives 16 full batches of 5
# delete statements each -- the same statement shape as test 03 -- and a 22-row
# last batch, for a 16.0 s floor.
#
# NO safety block: disable_foreign_key_checks applies only to the copy, and purge
# never copies. NO verification: a purge job with verification set is refused
# (spec §5). The runner asserts that nothing was verified (verify_method="none").
#
# The destination block is required even though purge reads no destination
# table: the tracking tables live in its job schema.
#
# This template is the tracked source of truth. run-tests.sh renders it to
# test06_payment_purge.yaml on every run, substituting the MYSQL_ROOT_PASSWORD placeholder from
# tests/.env. Edit this file, never the generated .yaml -- that one is gitignored
# (it holds a real password) and is overwritten.

source:
  host: 127.0.0.1
  port: 3305
  user: root
  password: ${MYSQL_ROOT_PASSWORD}
  database: sakila

destination:
  host: 127.0.0.1
  port: 3307
  user: root
  password: ${MYSQL_ROOT_PASSWORD}
  database: sakila_archive

# run_archive_job extracts the job name with `grep -A 1 "^jobs:" | tail -1`, so
# the job key must be the very next line -- no comment, and no trailing comment
# on the key itself, or the extracted name comes out mangled.
jobs:
  purge-payment-rows:
    job_type: purge
    root_table: payment
    primary_key: payment_id
    # Exactly half the table: 8022 of 16044 rows.
    where: "payment_id <= 8024"
    processing:
      batch_size: 500
      batch_delete_size: 100
      # 16 full batches x 0.2s = 3.2s; the 22-row last batch ends the run.
      sleep_seconds: 0.2
      # 16 full batches x 4 gaps x 0.2s = 12.8s. The 22-row last batch is one
      # statement and has no gap.
      delete_sleep_seconds: 0.2
