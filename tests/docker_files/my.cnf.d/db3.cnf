[mysqld]
local_infile              = ON
server_id		    = 3
report_host		    = db3.local

skip-name-resolve           = ON

# These were db2_binlog / db2_relaylog — copy-pasted from db2.cnf. Harmless at
# runtime (they are just filename prefixes) but actively misleading when reading
# a replication failure, since db2's and db3's logs were named identically.
log-bin                     = db3_binlog
log-bin-index               = db3_binlog.index
binlog-checksum             = NONE
binlog-row-image            = FULL
log_replica_updates         = 1

enforce-gtid-consistency    = TRUE
gtid-mode                   = ON
relay-log                   = db3_relaylog

# --- Memory sizing -----------------------------------------------------------
# See the comment in db1.cnf: innodb_dedicated_server MUST stay OFF, because an
# unbounded container detects the whole Docker VM and sizes itself for it.
# db3 only serves the replication-lag tests, so it gets the smallest share:
# 256M pool inside a 1g mem_limit.
innodb_dedicated_server     = OFF
innodb_buffer_pool_size     = 256M
innodb_buffer_pool_instances = 1
innodb_redo_log_capacity    = 128M
innodb_log_buffer_size      = 16M
innodb_numa_interleave      = OFF

# db3 only serves replication-lag tests; it never approached the limit. Raised
# modestly for headroom only. See db1.cnf.
max_connections             = 250

# Previously declared twice — the second was the malformed
# `plugin_load_add = clone     = mysql_clone.so`. One correct declaration.
plugin-load-add		    = mysql_clone.so
#clone_valid_donor_list	    = db1:3306,db2:3306
