# Test 03: High-volume payment archive (batch_size throughput)
#
# Archives a large slice of the payment table (a leaf in the Sakila graph)
# directly as the root, with batch_size=100, to exercise the batched pipeline
# over many batches (multi-batch copy + chunked deletes) through the real CLI
# (validate -> dry-run -> archive). payment is a leaf (no table references it), so
# it needs no relations; FK checks are disabled for the copy into the archive
# destination, whose payment table references the uncopied customer and staff.
#
# payment_id <= 2000 selects 1999 rows (MEASURED: payment_id is not contiguous):
# 19 full batches of 100 and a last batch of 99.
#
# verification: count, declared. 3.0's default is sha256 (R41); test 05 is the
# same slice under sha256, so the pair is an A/B on the method alone.
#
# This template is the tracked source of truth. run-tests.sh renders it to
# test03_payment_batch.yaml on every run, substituting the MYSQL_ROOT_PASSWORD placeholder from
# tests/.env. Edit this file, never the generated .yaml -- that one is gitignored
# (it holds a real password) and is overwritten.

source:
  host: 127.0.0.1
  port: 3305
  user: root
  password: ${MYSQL_ROOT_PASSWORD}
  database: sakila

destination:
  host: 127.0.0.1
  port: 3307
  user: root
  password: ${MYSQL_ROOT_PASSWORD}
  database: sakila_archive

safety:
  disable_foreign_key_checks: true

# run_archive_job extracts the job name with `grep -A 1 "^jobs:" | tail -1`, so
# the job key must be the very next line -- no comment, and no trailing comment
# on the key itself, or the extracted name comes out mangled.
jobs:
  archive-payment-rows:
    job_type: archive
    root_table: payment
    primary_key: payment_id
    # Archive a large slice to span many batches at batch_size=100
    where: "payment_id <= 2000"
    verification: count
    processing:
      batch_size: 100
      # 5 delete statements per batch, so 4 throttle sleeps per batch.
      batch_delete_size: 20
      # Slept after each of the 19 full batches; the short last batch ends the run.
      sleep_seconds: 0.2
      # Between consecutive delete statements of a batch, to limit binlog bursts.
      delete_sleep_seconds: 0.2
