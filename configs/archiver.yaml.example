# GoArchive Configuration Example
# Copy this file to archiver.yaml and customize for your environment

# Source database (production - data to archive)
source:
  host: source-db.internal
  port: 3306
  user: archiver
  password: change_me
  database: production
  tls: skip-verify  # disable, preferred, skip-verify, required
  max_connections: 10
  max_idle_connections: 5

# Destination database (archive storage)
destination:
  host: archive-db.internal
  port: 3306
  user: archiver
  password: change_me
  database: archive
  tls: skip-verify  # disable, preferred, skip-verify, required
  max_connections: 10
  max_idle_connections: 5
  # job_schema: goarchive   # optional; defaults to `database` above. Use this
  #                         # to isolate GoArchive tracking tables in their own
  #                         # schema. A DBA must CREATE DATABASE and grant:
  #                         #   GRANT CREATE, SELECT, INSERT, UPDATE ON goarchive.* TO <user>;
  #                         # The tool does NOT create schemas automatically.

# Replication gating (optional). While any monitored replica is lagging, stopped
# or unreachable, the job is HELD and the same run resumes once all recover.
# Replaces the 2.0 'replica:' block - see docs/README_UPGRADING_2_1.md.
replication:
  enabled: false
  seconds_behind_source_within: 10   # lag tolerance in seconds; 0 demands exact sync
  check_interval: 5                  # seconds between re-checks while holding
  cache_ttl: 15                      # seconds a PASSING verdict stays fresh; 0 = always check
  servers:
    - host: replica-db.internal
      port: 3306
      user: monitor                  # needs REPLICATION CLIENT
      password: change_me
      tls: preferred                 # disable, preferred, skip-verify, required
      type: async                    # only 'async' is supported in 2.1
      # Which replication channels to gate on. Omitted or [] gates on EVERY
      # channel the server reports. MySQL's default channel is named "" - an
      # empty name, not an absence - so [""] selects the default channel only.
      channels: []

# Archive jobs configuration
jobs:
  archive_old_orders:
    root_table: orders
    primary_key: id
    # Archive orders older than 2 years
    where: "created_at < DATE_SUB(NOW(), INTERVAL 2 YEAR)"
    # where is REQUIRED. To intentionally process the entire table, state it
    # explicitly:  where: "1=1"

    # Related tables (children discovered via BFS)
    relations:
      - table: order_items
        primary_key: id
        foreign_key: order_id
        dependency_type: "1-N"
      - table: order_payments
        primary_key: id
        foreign_key: order_id
        dependency_type: "1-N"
      - table: shipments
        primary_key: id
        foreign_key: order_id
        dependency_type: "1-1"
        relations:
          - table: shipment_items
            primary_key: id
            foreign_key: shipment_id
            dependency_type: "1-N"

    # Optional per-job logging (fields not set here are inherited from the
    # global logging block; CLI --log-level/--log-format flags win over both).
    # Give each job its own file to keep job runs in separate logs.
    # logging:
    #   level: info
    #   format: text
    #   output: /var/log/goarchive/archive_old_orders.log
    #   file_only: true        # don't tee this job's logs to stdout

# Processing settings (config-file only — there are no CLI overrides for these;
# each job may override any field in its own processing: block, and explicitly
# set fields win even when zero, e.g. sleep_seconds: 0 disables a global sleep)
processing:
  batch_size: 1000           # Root IDs per batch
  batch_delete_size: 500     # Rows per DELETE statement
  sleep_seconds: 1           # Pause between batches

# Safety settings
# NOTE: lag_threshold and check_interval were removed in 2.1 - they now live in
# the 'replication:' block above. A config still carrying them is REJECTED.
safety:
  disable_foreign_key_checks: false

# Verification settings
verification:
  method: count              # count or sha256
  skip_verification: false

# Logging settings
logging:
  level: info                # debug, info, warn, error
  format: json               # json or text
  output: stdout             # stdout, stderr, or file path
                             # a file path logs to the file AND stdout (tee)
  file_only: false           # true = log only to the file (requires output
                             # to be a file path); default false

# Log rotation: goarchive does not rotate log files itself. Files are opened
# in append mode, so external rotation is safe — e.g. logrotate with the
# `copytruncate` option (goarchive keeps the file handle open for the whole
# run), or rotate between runs when scheduling via cron.
