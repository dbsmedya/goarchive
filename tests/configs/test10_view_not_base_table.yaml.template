# Test 10: a VIEW named as the root table (validation demo — EXPECTED TO FAIL)
#
# `customer_list` is one of Sakila's seven views, not a base table. GoArchive
# archives base tables only: it deletes rows by primary key, and a view has no
# primary key to delete by. Preflight refuses it with TABLE_EXISTENCE_CHECK
# ("Only base tables can be archived") before anything is touched.
#
# WHY THIS TEST EXISTS -- it pins deviation D5: 1.8.0 reported PRIMARY_KEY_CHECK
# here, telling the operator to fix a primary key a view cannot have. The check now
# names the real problem.
#
# Everything else here is deliberately valid: one job, a real database, a real
# column name. The ONLY defect is that the root is a view, so nothing else can be
# what preflight objects to.
#
# This template is the tracked source of truth. run-tests.sh renders it to
# test10_view_not_base_table.yaml on every run, substituting the MYSQL_ROOT_PASSWORD placeholder from
# tests/.env. Edit this file, never the generated .yaml -- that one is gitignored
# (it holds a real password) and is overwritten.

source:
  host: 127.0.0.1
  port: 3305
  user: root
  password: ${MYSQL_ROOT_PASSWORD}
  database: sakila

destination:
  host: 127.0.0.1
  port: 3307
  user: root
  password: ${MYSQL_ROOT_PASSWORD}
  database: sakila_archive

# run_archive_job extracts the job name with `grep -A 1 "^jobs:" | tail -1`, so
# the job key must be the very next line -- no comment, and no trailing comment
# on the key itself, or the extracted name comes out mangled.
jobs:
  archive-customer-list-view:
    job_type: archive
    # customer_list is a VIEW. This is the single defect under test.
    #
    # `ID` is genuinely the view's column name (Sakila's views upper-case it), so
    # the config is not additionally wrong about the column.
    root_table: customer_list
    primary_key: ID
    where: "ID <= 10"
    relations: []
