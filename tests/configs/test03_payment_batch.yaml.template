# Test 03: High-volume payment archive (batch_size throughput)
# Archives a large slice of the payment table (a leaf in the Sakila graph)
# directly as the root, with batch_size=100, to exercise the batched pipeline
# over many batches (multi-batch copy + delete chunking).
#
# payment has ~16k rows; archiving payment_id <= 2000 drives ~20 batches of
# 100-row copy/delete chunks through the real CLI (validate -> dry-run ->
# archive). payment is a leaf (no table references it), so it needs no child
# relations; FK checks are disabled for the copy into the archive destination.
#
# This template is the tracked source of truth. run-tests.sh renders it to
# test03_payment_batch.yaml on every run, substituting the MYSQL_ROOT_PASSWORD
# placeholder from tests/.env. Edit this file, never the generated .yaml --
# that one is gitignored (it holds a real password) and is overwritten.

source:
  host: 127.0.0.1
  port: 3305
  user: root
  password: ${MYSQL_ROOT_PASSWORD}
  database: sakila

destination:
  host: 127.0.0.1
  port: 3307
  user: root
  password: ${MYSQL_ROOT_PASSWORD}
  database: sakila_archive

safety:
  disable_foreign_key_checks: true

jobs:
  archive-payment-rows:
    root_table: payment
    primary_key: payment_id
    # Archive a large slice to span many batches at batch_size=100
    where: "payment_id <= 2000"
    # batch_size=100 -> ~20 batches over the 2000 selected payment rows.
    # batch_delete_size=20 -> 5 delete chunks per batch (100 delete chunks total),
    # to observe how sleep_seconds interacts with delete chunking.
    processing:
      batch_size: 100
      batch_delete_size: 20
      # 0.2s, not 1s. At 1s this single test spent 20s of its 42s idling between
      # batches, and the throttle is exercised just as well at 0.2s.
      sleep_seconds: 0.2
      # Throttle deletes: pause 0.2s between each batch_delete_size delete chunk
      # to limit binlog generation / replication lag.
      delete_sleep_seconds: 0.2
