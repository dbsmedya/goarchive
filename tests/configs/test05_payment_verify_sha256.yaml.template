# Test 05: payment archive with SHA256 verification
#
# Deliberately identical to test 03 -- same root, same slice, same batch sizes --
# except for the verification method. That makes the pair an A/B on verification
# alone: if test 05 fails where test 03 passes, the method is the only variable
# that changed.
#
# sha256 hashes every copied row on both servers, in key order, inside the
# destination transaction, before the log write (spec §7.4). 2.x's INSERT IGNORE
# copy path is gone (spec §10): 3.0 copies with plain INSERT under every method.
#
# This template is the tracked source of truth. run-tests.sh renders it to
# test05_payment_verify_sha256.yaml on every run, substituting the MYSQL_ROOT_PASSWORD placeholder from
# tests/.env. Edit this file, never the generated .yaml -- that one is gitignored
# (it holds a real password) and is overwritten.

source:
  host: 127.0.0.1
  port: 3305
  user: root
  password: ${MYSQL_ROOT_PASSWORD}
  database: sakila

destination:
  host: 127.0.0.1
  port: 3307
  user: root
  password: ${MYSQL_ROOT_PASSWORD}
  database: sakila_archive

safety:
  disable_foreign_key_checks: true

# run_archive_job extracts the job name with `grep -A 1 "^jobs:" | tail -1`, so
# the job key must be the very next line -- no comment, and no trailing comment
# on the key itself, or the extracted name comes out mangled.
jobs:
  archive-payment-verify-sha256:
    job_type: archive
    root_table: payment
    primary_key: payment_id
    # Same slice as test 03, so the two are directly comparable.
    where: "payment_id <= 2000"
    # The whole point of this test.
    verification: sha256
    processing:
      batch_size: 100
      batch_delete_size: 20
      sleep_seconds: 0.2
      delete_sleep_seconds: 0.2
