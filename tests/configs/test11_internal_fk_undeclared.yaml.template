# Test 11: the customer -> rental -> payment GDPR diamond
#          (validation demo — EXPECTED TO FAIL)
#
# This is the shape operators ask for most — "archive everything belonging to this
# customer" — and GoArchive cannot represent it. This test is the gate for that
# limitation.
#
# WHY IT CANNOT BE REPRESENTED. A job is a TREE: each relation is nested under
# exactly one parent. But `payment` has TWO parents in the job here:
#
#     payment.rental_id   -> rental      (fk_payment_rental)
#     payment.customer_id -> customer    (fk_payment_customer)
#
# and `rental.customer_id -> customer` closes the diamond. Whichever parent
# payment is nested under, the other foreign key is not a relation of the job,
# and INTERNAL_FK_COVERAGE refuses it:
#
#   INTERNAL_FK_COVERAGE: Foreign keys between the job's tables must each be a
#   configured relation with the same foreign_key columns:
#     - payment(customer_id) -> customer(customer_id) (constraint fk_payment_customer)
#       [no relation: payment is not configured under customer]
#
# NOT FIXABLE BY REARRANGING: re-nesting payment only moves which edge is
# uncovered, and dropping either parent leaves customer referenced from outside
# the job, so FK_COVERAGE_CHECK fires instead. The passing shape is a narrower
# one: test 04's rental -> payment, where customer stays outside as an upstream
# parent.
#
# So the config below is *correct in every declaration it makes*. It fails because
# the requested topology is outside the model — which is exactly what makes it worth
# asserting: a change that quietly accepted a diamond would over-delete.
#
# Distinct from test 02 / FK_COVERAGE_CHECK, which is about tables OUTSIDE the job
# referencing tables inside it. This one is entirely internal.
#
# This template is the tracked source of truth. run-tests.sh renders it to
# test11_internal_fk_undeclared.yaml on every run, substituting the MYSQL_ROOT_PASSWORD placeholder from
# tests/.env. Edit this file, never the generated .yaml -- that one is gitignored
# (it holds a real password) and is overwritten.

source:
  host: 127.0.0.1
  port: 3305
  user: root
  password: ${MYSQL_ROOT_PASSWORD}
  database: sakila

destination:
  host: 127.0.0.1
  port: 3307
  user: root
  password: ${MYSQL_ROOT_PASSWORD}
  database: sakila_archive

# run_archive_job extracts the job name with `grep -A 1 "^jobs:" | tail -1`, so
# the job key must be the very next line -- no comment, and no trailing comment
# on the key itself, or the extracted name comes out mangled.
jobs:
  archive-customer-gdpr-diamond:
    job_type: archive
    root_table: customer
    primary_key: customer_id
    # Small slice: preflight never reads a row, so the bound only keeps the config
    # honest about being a plausible job.
    where: "customer_id <= 5"
    relations:
      # rental.customer_id -> customer. Correct, and declared.
      - table: rental
        primary_key: rental_id
        foreign_key: customer_id
        # payment MUST be nested here, not listed as a sibling: nesting is what
        # assigns a parent. A flat sibling entry is a child of the ROOT, so payment
        # with foreign_key: rental_id at that level would pair rental_id with
        # customer.customer_id and be refused by RELATION_KEY_CHECK -- a
        # different defect, and not the diamond at all.
        relations:
          # payment.rental_id -> rental. Correct, and declared.
          #
          # What no relation can express is payment's SECOND parent in the job,
          # payment.customer_id -> customer. That is the uncovered edge, and the
          # reason this job is refused.
          - table: payment
            primary_key: payment_id
            foreign_key: rental_id
