# The group estate's settings (tests/README.md → The group estate).
# Copy this file to .env.group and update the values as needed; `make test-up TOPOLOGY=group` does it
# for you when .env.group is missing, and the defaults work.
#
# These are what tests/dot.env holds for the plain estate, pointed at the group estate: the SOURCE is gr1,
# the group's primary; the DEST is a plain server; the REPLICA is an asynchronous replica of gr1. The two
# TEST_GROUP_MEMBER* servers are the group's other members, for the tests that need them.
#
# Load it, and keep the plain estate's .env out of the same shell:  set -a; source tests/.env.group; set +a
# TOPOLOGY=group tells the scripts which estate they are talking to.
MYSQL_ROOT_PASSWORD=your_password

# Source: gr1, the group's primary.
TEST_SOURCE_HOST=127.0.0.1
TEST_SOURCE_PORT=3410
TEST_SOURCE_USER=root
TEST_SOURCE_PASSWORD=your_password
TEST_SOURCE_DB=sakila

# The group's other two members (gr2, gr3), for the group-only tests.
TEST_GROUP_MEMBER2_HOST=127.0.0.1
TEST_GROUP_MEMBER2_PORT=3411
TEST_GROUP_MEMBER2_USER=root
TEST_GROUP_MEMBER2_PASSWORD=your_password
TEST_GROUP_MEMBER3_HOST=127.0.0.1
TEST_GROUP_MEMBER3_PORT=3412
TEST_GROUP_MEMBER3_USER=root
TEST_GROUP_MEMBER3_PASSWORD=your_password

# Destination: gr-dest, a plain server with db2's settings.
TEST_DEST_HOST=127.0.0.1
TEST_DEST_PORT=3413
TEST_DEST_USER=root
TEST_DEST_PASSWORD=your_password
TEST_DEST_DB=sakila_archive

# Replica: gr-replica, an asynchronous replica of gr1.
TEST_REPLICA_HOST=127.0.0.1
TEST_REPLICA_PORT=3414
TEST_REPLICA_USER=root
TEST_REPLICA_PASSWORD=your_password

# Replication topology (tests/scripts/setup-replication.sh), as in dot.env, except that the replica reaches
# its source, gr1, over the compose network as gr1:3306, which REPL_SOURCE_HOST names.
REPL_SOURCE_HOST=gr1
REPL_USER=repl
REPL_PASSWORD=your_repl_password
REPL_POSITIONING=gtid

# Dump Directory (as in dot.env)
DUMP_DIR=/tmp/db1_schema_dump
