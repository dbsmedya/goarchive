# Test 08: payment archive, stopped gracefully at a batch boundary, then resumed
#
# Deliberately IDENTICAL to test 05's config. Same root, same slice, same batch
# sizes, same verification method -- the interrupt lives entirely in the harness,
# not in this file. That makes test 05 this test's uninterrupted control: a
# failure in 08 but not in 05 isolates to the interrupt.
#
# What this covers that no integration test does: a real process signalled and
# restarted. A single SIGTERM is cooperative: the batch in flight finishes, the
# run stops at the next batch boundary and reports it, and every logged root is
# 'completed'. Run 2 has nothing to replay; it continues the where range, whose
# archived roots are gone from the source. 3.0 keeps no cursor (R10).
#
# NO sentinel_file: the harness waits for the engine's "Batch 1:" line and
# signals during the sleep that follows it.
#
# This template is the tracked source of truth. run-tests.sh renders it to
# test08_payment_graceful_resume.yaml on every run, substituting the MYSQL_ROOT_PASSWORD placeholder from
# tests/.env. Edit this file, never the generated .yaml -- that one is gitignored
# (it holds a real password) and is overwritten.

source:
  host: 127.0.0.1
  port: 3305
  user: root
  password: ${MYSQL_ROOT_PASSWORD}
  database: sakila

destination:
  host: 127.0.0.1
  port: 3307
  user: root
  password: ${MYSQL_ROOT_PASSWORD}
  database: sakila_archive

safety:
  disable_foreign_key_checks: true

# run_archive_job extracts the job name with `grep -A 1 "^jobs:" | tail -1`, so
# the job key must be the very next line -- no comment, and no trailing comment
# on the key itself, or the extracted name comes out mangled.
jobs:
  archive-payment-graceful-resume:
    job_type: archive
    root_table: payment
    primary_key: payment_id
    # Same slice as tests 03 and 05 -- 1999 rows, MEASURED not computed
    # (payment_id is not contiguous, so <= 2000 is not 2000).
    where: "payment_id <= 2000"
    verification: sha256
    processing:
      batch_size: 100
      batch_delete_size: 20
      # The graceful window: the signal lands in this sleep after batch 1.
      sleep_seconds: 0.2
      delete_sleep_seconds: 0.2
